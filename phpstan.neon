# Known errors are listed in the baseline. CI fails only on errors not listed here.
# When you fix one, PHPStan reports the stale entry: regenerate with
#   ./vendor/bin/phpstan analyse --generate-baseline phpstan-baseline.neon --allow-empty-baseline
includes:
    - phpstan-baseline.neon

parameters:
    # Level 9 (explicit mixed) is deliberately not used: it forces assert()/@var narrowing
    # on config and DB rows. Level 8 keeps the null checks.
    level: 8
    paths:
        - src
        - config
        - public
        - console.php
    bootstrapFiles:
        - phpstan-bootstrap.php
    stubFiles:
        - stubs/OpisDatabase.stub
        - stubs/PhpDi.stub
    # Docblock types stay "certain" (the default) so enum/match typos are caught. When PHPStan
    # calls a defensive check dead because of a docblock, verify the docblock before deleting the check.
    ignoreErrors:
        # Plain `array` is allowed; add array<...> docblocks only where they help.
        -
            identifier: missingType.iterableValue
            reportUnmatched: false
        # Defensive `?? default` fallbacks on maps that currently cover every key are allowed.
        -
            identifier: nullCoalesce.offset
            reportUnmatched: false
