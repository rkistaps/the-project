#!/usr/bin/env bash

# Manage the Docker environment. Run without arguments for the list of commands.

source "$(dirname "$0")/docker-conf/scripts.sh"

usage() {
  cat <<'USAGE'
Usage: ./docker <command>

  start     Start the containers (creates them on first run)
  stop      Stop and remove the containers; the database volume is kept
  restart   stop, then start
  build     Rebuild the images, e.g. after changing docker-conf/
  ssh       Open a shell in the app container, starting it if needed
  logs      Follow the container logs; extra arguments go to `docker compose logs`, e.g. ./docker logs db
  status    Show the containers and their ports

Run things inside the container with ./docker-run, ./docker-test, ./docker-coverage and ./docker-analyse.
USAGE
}

start() {
  docker compose up -d
}

stop() {
  docker compose down --remove-orphans
}

restart() {
  stop
  start
}

build() {
  docker compose build
}

ssh() {
  if [[ -z "$(app_container)" ]]; then
    start
  fi

  docker compose exec app bash
}

logs() {
  docker compose logs -f "$@"
}

status() {
  docker compose ps
}

case "$1" in
  start | stop | restart | build | ssh | logs | status)
    "$1" "${@:2}"
    ;;
  "" | help | -h | --help)
    usage
    ;;
  *)
    echo "Unknown command: $1"
    echo
    usage
    exit 1
    ;;
esac
