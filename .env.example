# Copy to .env and adjust. Variables set in the real environment (Docker, CI, the shell) win over this file.

# dev or prod
APP_ENV=dev
# Shows the Whoops debug page for uncaught errors. Never turn this on in production.
APP_DEBUG=true

# How the host reaches the database. Inside Docker the app connects to db:3306 instead
# (set in docker-compose.yml), so these only matter for tools run on the host.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=theapp
DB_USER=theapp
DB_PASSWORD=theapp
# Used only by the database container when it creates the database
DB_ROOT_PASSWORD=theapp
