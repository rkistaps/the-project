# Copy to .env and adjust. Variables set in the real environment (Docker, CI, the shell) win over this file.

# Prefix for the Docker container, network and volume names (e.g. the-project-app-1)
COMPOSE_PROJECT_NAME=the-project

# dev or prod
APP_ENV=dev
# Shows the Whoops debug page for uncaught errors. Never turn this on in production.
APP_DEBUG=true

# Host ports for the web server. Change them to run next to another project that uses 80/443.
HTTP_PORT=80
HTTPS_PORT=443

# How the host reaches the database: DB_PORT is also the host port the database is published on.
# Inside Docker the app connects to db:3306 instead (set in docker-compose.yml).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=theapp
DB_USER=theapp
DB_PASSWORD=theapp
# Used only by the database container when it creates the database
DB_ROOT_PASSWORD=theapp
