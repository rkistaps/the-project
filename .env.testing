# Loaded by the tests (tests/bootstrap.php) before .env, so these values win over .env.
# Real environment variables (Docker, CI) still win over both.

APP_ENV=test
APP_DEBUG=false

# The test database. ./docker start creates it next to the app's database as <DB_NAME>_test
# (docker-conf/mysql-init). Tests roll back what they write, and refuse a name without _test.
DB_NAME=theapp_test
